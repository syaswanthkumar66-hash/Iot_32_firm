menu "IoTyk Relay Firmware Configuration"

    config IOTYK_TESTING_MODE
        bool "Enable Testing Mode (serial debug, export credentials)"
        default y
        help
            When enabled, serial commands and credential export are available.
            Disable for production.

    config IOTYK_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            WiFi network name.

    config IOTYK_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            WiFi password.

    config IOTYK_MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtts://test.mosquitto.org"
        help
            MQTT broker address with protocol.

    config IOTYK_OTA_FIRMWARE_URL
        string "OTA Firmware URL"
        default "https://example.com/iotyk_fw.bin"
        help
            URL for OTA firmware download.

endmenu
